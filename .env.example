# 복사해서 .env 로 쓴다. .env 는 .gitignore 에 있다.
# 이 저장소는 공개다 — 실제 값이 커밋되면 즉시 폐기하고 재발급할 것.

# ---- Threads (docs/03-threads-api.md)
# https://developers.facebook.com/docs/threads 에서 앱 생성 후 발급
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
# long-lived token: 60일 만료. 발급 24시간 후 ~ 60일 사이에 갱신해야 한다.
THREADS_ACCESS_TOKEN=
THREADS_TOKEN_ISSUED_AT=

# ---- 초안 생성 (파이프라인 ④, 구현 예정)
ANTHROPIC_API_KEY=

# ---- 휴먼 게이트 알림 (파이프라인 ⑤, 선택)
# 미설정 시 마크다운 파일로만 출력한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 동작 설정
# 하루 발행 목표. API 상한(250)이 아니라 현실적인 목표치를 둔다.
DAILY_POST_TARGET=3
# 초안 생성 건수 (여기서 골라 발행한다)
DAILY_DRAFT_COUNT=5
# 중복 판정 임계값 — 제목 임베딩 코사인 유사도
DEDUP_SIMILARITY_THRESHOLD=0.85
# Hacker News 최소 점수
HN_MIN_POINTS=100
